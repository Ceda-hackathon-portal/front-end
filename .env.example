# Copy to .env.local for local development. Vite exposes only VITE_* variables to the browser,
# so never put secrets here: everything below ends up in the public bundle.

# Base URL of backend-api, without /api/v1 and without a trailing slash
VITE_API_URL=http://localhost:3001

# Development only: enables the backend's local password login form.
# Configure both values in an ignored .env.local; never use this for hosted builds.
VITE_LOCAL_AUTH=false
VITE_LOCAL_AUTH_EMAIL=

# Set these only after a published backend programme/version has been provisioned.
# The applicant create endpoint does not expose programme discovery yet.
VITE_CEDA_PROGRAMME_ID=
VITE_CEDA_PROGRAMME_VERSION_ID=

# Optional dev-server API proxy target when VITE_API_URL points to the frontend origin.
# CEDA_DEV_API_TARGET=http://localhost:3001
